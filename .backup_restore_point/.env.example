# Application Runtime
NODE_ENV=production
PORT=3000

# Security Secrets (Set strong random secrets in production)
JWT_SECRET=CHANGE_ME_TO_A_SECURE_JWT_SECRET
SESSION_SECRET=CHANGE_ME_TO_A_SECURE_SESSION_SECRET

# Database Connection (Docker Compose internal network host: 'postgres')
DATABASE_URL=postgresql://dawamy_user:dawamy_secure_password@postgres:5432/dawamy_db?schema=public

# Optional: Gemini API Key (Backend-only, never sent to browser)
GEMINI_API_KEY=

# Optional: Application URL
APP_URL=
