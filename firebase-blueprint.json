{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role, quota balances, direct manager, and personal information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "nameEn": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["employee", "manager", "hr", "admin"] },
        "department": { "type": "string", "maxLength": 100 },
        "departmentEn": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 100 },
        "titleEn": { "type": "string", "maxLength": 100 },
        "managerName": { "type": "string", "maxLength": 128 },
        "managerId": { "type": "string", "maxLength": 128 },
        "avatar": { "type": "string", "maxLength": 500 },
        "todayStatus": { "type": "string", "maxLength": 50 },
        "balances": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "role", "email"]
    },
    "WorkRequest": {
      "title": "WorkRequest",
      "description": "Leave or remote work (WFH) request submitted by an employee",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "userNameEn": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["remote", "annual_leave", "sick_leave", "emergency_leave", "half_day_remote"] },
        "startDate": { "type": "string", "maxLength": 32 },
        "endDate": { "type": "string", "maxLength": 32 },
        "totalDays": { "type": "number" },
        "reason": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending_manager", "pending_hr", "approved", "rejected", "cancelled"] },
        "handoverColleague": { "type": "string", "maxLength": 128 },
        "handoverPlan": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "managerApprovalDate": { "type": "string", "maxLength": 64 },
        "hrApprovalDate": { "type": "string", "maxLength": 64 },
        "rejectionReason": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "type", "startDate", "endDate", "totalDays", "status", "reason"]
    },
    "CheckInRecord": {
      "title": "CheckInRecord",
      "description": "Daily virtual check-in and presence status",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 32 },
        "locationType": { "type": "string", "enum": ["home", "office", "other"] },
        "status": { "type": "string", "enum": ["wfh_active", "in_office", "on_leave", "in_meeting", "deep_focus"] },
        "tasks": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "userId", "date", "time", "locationType", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notification for requests and updates",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 1000 },
        "messageEn": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "enum": ["approval", "rejection", "reminder", "system"] },
        "read": { "type": "boolean" },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "message", "type", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and settings"
    },
    "/requests/{requestId}": {
      "schema": "WorkRequest",
      "description": "Work and leave requests collection"
    },
    "/checkins/{checkinId}": {
      "schema": "CheckInRecord",
      "description": "Daily virtual check-in logs"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Notifications collection"
    }
  }
}
